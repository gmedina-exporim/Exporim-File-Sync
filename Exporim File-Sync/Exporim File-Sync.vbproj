<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CS</RootNamespace>
    <AssemblyName>Exporim File-Sync</AssemblyName>
    <StartupObject>Sub Main</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\program icons\create-synchronicity-icon.ico</ApplicationIcon>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>Off</OptionInfer>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <NoWarn>NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IO interface.vb" />
    <Compile Remove="Revision.template.vb" />
    <Compile Remove="languages\language_update.vb" />
    <!-- Revision.vb is generated by the StampRevision target below; explicit Include
         (rather than relying on implicit globbing) so it's part of the compile list
         even on a clean checkout, before the file exists on disk. -->
    <Compile Remove="Revision.vb" />
    <Compile Include="Revision.vb" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\program icons\create-synchronicity-icon-16x16.ico">
      <LogicalName>CS.create-synchronicity-icon-16x16.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="COPYING">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Release notes.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="languages\*.lng">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="languages\local-names.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- compress.dll and its SharpZipLib dependency are built by the Compressor project (see its
       CopyCompressorPluginToApp target). They aren't a compile-time reference of this project
       (loaded dynamically at runtime via Assembly.LoadFrom), so `dotnet publish` doesn't know
       about them on its own. Reference them directly from the Compressor project's own (RID-
       independent) output folder rather than via $(OutDir), since publish's $(OutDir) gets a
       runtime-identifier subfolder (e.g. win-x64) that the Compressor project itself never uses.
       Run `dotnet build "Exporim File-Sync.sln" -c $(Configuration)` once before publishing so
       these Exists() checks - evaluated when this project loads - find them already built. -->
  <ItemGroup>
    <Content Include="..\Compressor\bin\$(Configuration)\net8.0-windows\compress.dll" Condition="Exists('..\Compressor\bin\$(Configuration)\net8.0-windows\compress.dll')">
      <Link>compress.dll</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Compressor\bin\$(Configuration)\net8.0-windows\ICSharpCode.SharpZipLib.dll" Condition="Exists('..\Compressor\bin\$(Configuration)\net8.0-windows\ICSharpCode.SharpZipLib.dll')">
      <Link>ICSharpCode.SharpZipLib.dll</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="StampRevision" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\StampRevision.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
