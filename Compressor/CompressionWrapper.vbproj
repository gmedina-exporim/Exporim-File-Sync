<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>GZipCompressor</RootNamespace>
    <AssemblyName>compress</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exporim File-Sync\Exporim File-Sync.vbproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyCompressorPluginToApp" AfterTargets="Build">
    <ItemGroup>
      <CompressorPluginFiles Include="$(TargetDir)compress.dll" />
      <CompressorPluginFiles Include="$(TargetDir)ICSharpCode.SharpZipLib.dll" />
    </ItemGroup>
    <!-- The main app targets net8.0-windows while this project targets plain net8.0, so its own $(OutDir) can't be reused verbatim for the destination. -->
    <Copy SourceFiles="@(CompressorPluginFiles)" DestinationFolder="..\Exporim File-Sync\bin\$(Configuration)\net8.0-windows" SkipUnchangedFiles="true" Condition="Exists('..\Exporim File-Sync\bin\$(Configuration)\net8.0-windows')" />
  </Target>

</Project>
